  <h2 class="section-title">District Dates</h2>
  <p class="section-sub">March revival &amp; district meeting dates, as reported by each District Superintendent</p>
  <div class="districts">
    <table class="dtable">
      <thead><tr><th>District</th><th>Superintendent</th><th>2027 Dates</th></tr></thead>
      <tbody>
<tr><td class="dist-name">A. B. McEwen</td><td>Don Coleman</td><td>March 11, 12 &amp; 14</td></tr>
      <tr><td class="dist-name">C. C. Knox</td><td>Earlie Nickols, Jr.</td><td>March 3&ndash;4</td></tr>
      <tr><td class="dist-name">D. D. Chandler</td><td>Danny O. Blayde</td><td>March 16, 17 &amp; 18</td></tr>
      <tr><td class="dist-name">E. W. Rodgers</td><td>Micheal Lowe</td><td>March 24, 25 &amp; 26</td></tr>
      <tr><td class="dist-name">F. D. Macklin</td><td>David Warner</td><td>March 7 &amp; 21</td></tr>
      <tr><td class="dist-name">J. D. Porter</td><td>David Johnson</td><td>March 11, 12 &amp; 14</td></tr>
      <tr><td class="dist-name">J. E. Chandler</td><td>Perry Little</td><td>March 14 &amp; 21</td></tr>
      <tr><td class="dist-name">New Pathway</td><td>John Lee</td><td>March 14</td></tr>
      <tr><td class="dist-name">R. C. McNeal</td><td>Carl B. Sanders</td><td>April 29, 30 &amp; May 2</td></tr>
      <tr><td class="dist-name">Rehoboth</td><td>Angelo Beard</td><td>March 17, 18 &amp; 19 <span class="flag" title="The 2027 Calendar Agenda poster lists Rehoboth as March 7, 8 &amp; 9 instead — please confirm with Supt. Beard.">verify</span></td></tr>
      <tr><td class="dist-name">Samuel Maxwell</td><td>Clifford Causey</td><td>March 24, 25 &amp; 26</td></tr>
      <tr><td class="dist-name">Walk of Faith</td><td>David Kelley</td><td>March 18 &amp; 19</td></tr>
      <tr><td class="dist-name">Walter B. Shannon, Sr.</td><td>Earl Shannon</td><td>March 24 &amp; 25</td></tr>
      </tbody>
    </table>
  </div>

  <div class="theme-block">
    <div class="tline">&ldquo;Working While It Is Day&rdquo;</div>
    <div class="ttag">Determination &middot; Working Together &middot; God&rsquo;s Glory</div>
    <div class="tscripture">&ldquo;I must work the works of him that sent me, while it is day&rdquo; &mdash; John 9:4 &nbsp;&middot;&nbsp; &ldquo;Being confident of this very thing, that he which hath begun a good work in you will perform it&rdquo; &mdash; Philippians 1:6</div>
  </div>

  <div class="aux">
    <h2>Items to Confirm with the Committee</h2>
    <p class="lead">Two sources gave different dates for these three items &mdash; shown here as reported, pending confirmation.</p>
    <ul>
      <li><span>Workers&rsquo; Meeting</span><span>Feb 24&ndash;26 (poster) vs. Feb 25&ndash;26 (secretary&rsquo;s list)</span></li>
      <li><span>Holy Convocation</span><span>Jul 16&ndash;19 (poster) vs. Jul 20, single day (earlier list)</span></li>
      <li><span>Rehoboth District</span><span>Mar 17, 18 &amp; 19 (Supt. Beard) vs. Mar 7, 8 &amp; 9 (poster)</span></li>
    </ul>
  </div>

  <details class="update" id="updatePanel">
    <summary>Committee Update &mdash; add or delete a date on this calendar</summary>
    <div class="update-body">
      <div id="gatePrompt">
        <label for="code">Enter committee code to unlock adding or deleting dates</label>
        <input type="password" id="code" inputmode="numeric" maxlength="8" placeholder="Code">
        <button class="update-btn" id="unlockBtn" type="button">Unlock</button>
        <p class="update-msg" id="gateMsg"></p>
      </div>
      <form id="addForm" hidden>
        <p class="update-hint">Unlocked. To <strong>delete</strong> an existing date, scroll up and click the &times; next to it on the calendar. To <strong>add</strong> a new date, fill out the form below.</p>
        <div class="update-row">
          <div>
            <label for="f-month">Month</label>
            <select id="f-month">
              <option>January</option><option>February</option><option>March</option><option>April</option>
              <option>May</option><option>June</option><option>July</option><option>August</option>
              <option>September</option><option>October</option><option>November</option><option>December</option>
            </select>
          </div>
          <div>
            <label for="f-date">Date (e.g. Mar 15 or Mar 15&ndash;16)</label>
            <input type="text" id="f-date" placeholder="e.g. Mar 15">
          </div>
        </div>
        <div class="update-row">
          <div>
            <label for="f-time">Time (optional)</label>
            <input type="text" id="f-time" placeholder="e.g. 7:00 PM">
          </div>
          <div>
            <label for="f-sub">Sponsor / department (optional)</label>
            <input type="text" id="f-sub" placeholder="e.g. Music Department">
          </div>
        </div>
        <label for="f-kind">Category (optional)</label>
        <select id="f-kind">
          <option value="" selected>No category</option>
          <option value="special">Special / Convention</option>
          <option value="conf">Leadership Conference / Prayer Line</option>
          <option value="assembly">Jurisdictional Assembly</option>
          <option value="council">Pastor &amp; Elders Council</option>
          <option value="mpc">Midnight Prayer Cry</option>
          <option value="__new__">+ Add a new category&hellip;</option>
        </select>
        <input type="text" id="f-kind-new" placeholder="Name the new category, e.g. Youth Conference" hidden>
        <label for="f-title">What&rsquo;s the event?</label>
        <textarea id="f-title" placeholder="I need to add&hellip;"></textarea>
        <button class="update-btn" type="submit">Add to Calendar</button>
        <p class="update-msg" id="addMsg"></p>
      </form>
      <div class="added-list" id="addedList"></div>
    </div>
  </details>

  <p class="printhint">Tip: this calendar is built to print cleanly &mdash; use your browser&rsquo;s Print command for a paper copy.</p>

  <footer>
    <div class="foot-info">
      <span class="org">Office of the Jurisdictional Secretary</span>
      <strong>Pastor Stephen C. McNeal, MDiv.</strong>, Jurisdictional Secretary<br>
      tnfifthsecretary@gmail.com &nbsp;&middot;&nbsp; 615.473.3878 &nbsp;&middot;&nbsp; P.O. Box 42143, Memphis, TN 38174
    </div>
    <div class="foot-qr">
      <div class="qr-box"><canvas id="siteQr" width="104" height="104" aria-label="QR code linking to tn5thcalendar.com"></canvas></div>
      <div class="qr-cap">Scan to visit<br><span class="qr-url">tn5thcalendar.com</span></div>
      <button class="qr-dl" id="qrDownloadBtn" type="button">Download QR Code</button>
    </div>
  </footer>

</div>

<script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script>
<script>
(function(){
  var PASSCODE = "3208";
  var unlocked = false;

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
    });
  }

  // --- Next up badge ---
  function initNextUp(){
    var evs = Array.prototype.slice.call(document.querySelectorAll('.ev[data-date]'));
    var now = new Date();
    var upcoming = evs.map(function(el){
      return {el: el, date: new Date(el.getAttribute('data-date')+'T00:00:00')};
    }).filter(function(x){ return x.date.getTime() >= now.getTime(); })
      .sort(function(a,b){ return a.date - b.date; });
    var box = document.getElementById('nextup');
    if (upcoming.length){
      var next = upcoming[0];
      next.el.classList.add('is-next');
      var badge = document.createElement('span');
      badge.className = 'nextbadge';
      badge.textContent = 'Next Up';
      next.el.style.position = 'relative';
      next.el.appendChild(badge);
      var days = Math.round((next.date - now) / 86400000);
      var titleEl = next.el.querySelector('.ev-title');
      var label = titleEl ? titleEl.textContent.replace(/\s*verify\s*$/,'') : 'an event';
      box.innerHTML = 'Next on the calendar: <strong>' + escapeHtml(label) + '</strong> &mdash; in ' + days + ' day' + (days===1?'':'s');
    } else if (box) {
      box.textContent = '';
    }
  }
  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initNextUp);
  } else {
    initNextUp();
  }

  // --- QR code (links to the custom domain) ---
  function initQr(){
    var canvas = document.getElementById('siteQr');
    if (!canvas) return;
    var url = 'https://tn5thcalendar.com';
    if (typeof QRious === 'undefined'){
      var box = canvas.closest('.qr-box');
      if (box){ box.outerHTML = '<a href="' + url + '" style="font-family:\'Jost\',sans-serif;font-size:11px;">' + url + '</a>'; }
      var missingBtn = document.getElementById('qrDownloadBtn');
      if (missingBtn) missingBtn.remove();
      return;
    }
    new QRious({
      element: canvas,
      value: url,
      size: 208,
      level: 'H',
      background: '#ffffff',
      foreground: '#2B2033',
      padding: 6
    });
    canvas.style.width = '104px';
    canvas.style.height = '104px';
    var dlBtn = document.getElementById('qrDownloadBtn');
    if (dlBtn){
      dlBtn.addEventListener('click', async function(){
        var originalLabel = dlBtn.textContent;
        try{
          var downloadsApi = null;
          if (window.claude && window.claude.use){
            try{ downloadsApi = await window.claude.use('downloads'); }catch(e){ downloadsApi = null; }
          }
          if (downloadsApi){
            canvas.toBlob(async function(blob){
              if (!blob) return;
              try{
                await downloadsApi.save({ filename: 'tn5thcalendar-qr.png', data: blob });
              }catch(e){ /* viewer declined, or saves unavailable right now; nothing more to do */ }
            }, 'image/png');
          } else {
            /* Outside claude.ai (e.g. GitHub Pages, Netlify) there's no sandbox,
               so a plain browser download works directly. */
            var dataUrl = canvas.toDataURL('image/png');
            var a = document.createElement('a');
            a.href = dataUrl;
            a.download = 'tn5thcalendar-qr.png';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }
        }catch(e){ /* no-op; right-click > Save Image As on the QR code always still works */ }
      });
    }
  }
  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initQr);
  } else {
    initQr();
  }

  // --- Committee update panel ---
  var db = null;
  var addedEls = {};
  var MONTH_IDS = {January:'jan',February:'feb',March:'mar',April:'apr',May:'may',June:'jun',July:'jul',August:'aug',September:'sep',October:'oct',November:'nov',December:'dec'};

  var KIND_LABELS = {assembly:'Assembly', conf:'Conference Line', mpc:'Prayer Cry', special:'Special Event', council:'P&amp;E Council', general:'General'};

  function renderAdded(id, doc){
    var month = doc.month || 'January';
    var mid = MONTH_IDS[month] || 'jan';
    var card = document.getElementById('m-' + mid);
    if (!card) return;
    var list = card.querySelector('.ev-list');
    if (!list) return;
    var kind = (doc.kind && KIND_LABELS[doc.kind]) ? doc.kind : 'general';
    var tagLabel = doc.kindLabel ? escapeHtml(doc.kindLabel) : KIND_LABELS[kind];
    var li = addedEls[id];
    if (!li){
      li = document.createElement('li');
      li.setAttribute('data-id', id);
      addedEls[id] = li;
    }
    li.className = 'ev ev-' + kind;
    li.innerHTML =
      '<span class="ev-date"><span class="ev-day">' + escapeHtml(doc.date||'') + '</span><span class="ev-dow"></span></span>' +
      '<span class="ev-body"><span class="ev-title">' + escapeHtml(doc.title||'') + '</span>' +
      (doc.sub ? '<span class="ev-sub">' + escapeHtml(doc.sub) + '</span>' : '') + '</span>' +
      '<span class="ev-time">' + escapeHtml(doc.time||'') +
        '<button class="ev-del" type="button" data-id="' + id + '" data-kind="added" title="Remove this date">&times;</button></span>' +
      '<span class="ev-tag tag-' + kind + '">' + tagLabel + '</span>';
    if (li.parentNode !== list) list.appendChild(li);
  }

  function removeAdded(id){
    var li = addedEls[id];
    if (li && li.parentNode) li.parentNode.removeChild(li);
    delete addedEls[id];
  }

  function subscribeAdditions(){
    if (!db) return;
    try{
      db.collection('calendar_additions').onSnapshot(function(snap){
        snap.docChanges().forEach(function(ch){
          if (ch.type === 'removed'){ removeAdded(ch.doc.id); }
          else { renderAdded(ch.doc.id, ch.doc.data() || {}); }
        });
      }, function(err){ /* store unreachable right now; page still works without live data */ });
    }catch(e){ /* no-op */ }
  }

  function subscribeDeletions(){
    if (!db) return;
    try{
      db.collection('calendar_deletions').onSnapshot(function(snap){
        snap.docChanges().forEach(function(ch){
          if (ch.type === 'removed') return;
          var li = document.querySelector('.ev[data-id="' + ch.doc.id + '"]');
          if (li && li.parentNode) li.parentNode.removeChild(li);
        });
      }, function(err){ /* no-op */ });
    }catch(e){ /* no-op */ }
  }

  // --- Local fallback (used when this page is hosted outside claude.ai,
  // e.g. on GitHub Pages or Netlify, where the live database isn't available).
  // Keeps additions/removals in this browser via localStorage so they
  // survive a reload on the same device, instead of resetting every visit.
  var LS_ADD = 'tn5_calendar_additions';
  var LS_DEL = 'tn5_calendar_deletions';
  function lsGet(key){
    try{ return JSON.parse(localStorage.getItem(key) || '{}'); }catch(e){ return {}; }
  }
  function lsSet(key, obj){
    try{ localStorage.setItem(key, JSON.stringify(obj)); }catch(e){ /* storage unavailable; degrade silently */ }
  }
  function applyLocalFallback(){
    var dels = lsGet(LS_DEL);
    Object.keys(dels).forEach(function(id){
      var li = document.querySelector('.ev[data-id="' + id + '"]');
      if (li && li.parentNode) li.parentNode.removeChild(li);
    });
    var adds = lsGet(LS_ADD);
    Object.keys(adds).forEach(function(id){ renderAdded(id, adds[id]); });
  }

  (async function(){
    try{
      if (window.claude && window.claude.use){
        db = await window.claude.use('db');
      }
    }catch(e){ db = null; }
    if (db){ subscribeAdditions(); subscribeDeletions(); }
    else { applyLocalFallback(); }
  })();

  document.getElementById('f-kind').addEventListener('change', function(){
    var newInput = document.getElementById('f-kind-new');
    if (this.value === '__new__'){
      newInput.removeAttribute('hidden');
      newInput.focus();
    } else {
      newInput.setAttribute('hidden','');
      newInput.value = '';
    }
  });

  document.getElementById('unlockBtn').addEventListener('click', function(){
    var val = document.getElementById('code').value.trim();
    var msg = document.getElementById('gateMsg');
    if (val === PASSCODE){
      unlocked = true;
      document.body.classList.add('committee-mode');
      document.getElementById('gatePrompt').setAttribute('hidden','');
      document.getElementById('addForm').removeAttribute('hidden');
      msg.textContent = '';
    } else {
      msg.textContent = 'That code is not correct.';
      msg.className = 'update-msg err';
    }
  });

  document.getElementById('monthgrid').addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('.ev-del') : null;
    if (!btn || !unlocked) return;
    var li = btn.closest('.ev');
    var id = btn.getAttribute('data-id');
    var kind = btn.getAttribute('data-kind');
    if (!id || !li) return;
    if (li.parentNode) li.parentNode.removeChild(li);
    if (kind === 'added'){
      delete addedEls[id];
      if (db){
        db.collection('calendar_additions').doc(id).delete().catch(function(){});
      } else {
        var adds = lsGet(LS_ADD); delete adds[id]; lsSet(LS_ADD, adds);
      }
    } else {
      if (db){
        db.collection('calendar_deletions').doc(id).set({deleted:true}).catch(function(){});
      } else {
        var dels = lsGet(LS_DEL); dels[id] = true; lsSet(LS_DEL, dels);
      }
    }
  });

  document.getElementById('addForm').addEventListener('submit', async function(e){
    e.preventDefault();
    if (!unlocked) return;
    var month = document.getElementById('f-month').value;
    var date = document.getElementById('f-date').value.trim();
    var time = document.getElementById('f-time').value.trim();
    var sub = document.getElementById('f-sub').value.trim();
    var title = document.getElementById('f-title').value.trim();
    var kindSel = document.getElementById('f-kind').value;
    var kindNew = document.getElementById('f-kind-new').value.trim();
    var msg = document.getElementById('addMsg');
    if (!date || !title){
      msg.textContent = 'Please add at least a date and a description.';
      msg.className = 'update-msg err';
      return;
    }
    if (kindSel === '__new__' && !kindNew){
      msg.textContent = 'Please name the new category, or choose "No category."';
      msg.className = 'update-msg err';
      return;
    }
    var kind = (kindSel === '__new__') ? 'general' : (kindSel || 'general');
    var kindLabel = (kindSel === '__new__') ? kindNew : null;
    var id = 'c' + Date.now() + Math.floor(Math.random()*1000);
    var doc = {month: month, date: date, time: time, sub: sub, title: title, kind: kind};
    if (kindLabel) doc.kindLabel = kindLabel;
    if (db){
      try{
        await db.collection('calendar_additions').doc(id).set(doc);
      }catch(err){
        renderAdded(id, doc); /* store unavailable right now; show it locally for this visit */
      }
    } else {
      var adds = lsGet(LS_ADD); adds[id] = doc; lsSet(LS_ADD, adds);
      renderAdded(id, doc);
    }
    msg.textContent = 'Added to ' + month + '.';
    msg.className = 'update-msg ok';
    document.getElementById('f-date').value = '';
    document.getElementById('f-time').value = '';
    document.getElementById('f-sub').value = '';
    document.getElementById('f-title').value = '';
    document.getElementById('f-kind').selectedIndex = 0;
    document.getElementById('f-kind-new').value = '';
    document.getElementById('f-kind-new').setAttribute('hidden','');
  });
})();
</script>

</body>
</html>
